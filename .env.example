# Public site origin for canonical URLs, sitemap, robots, and social previews.
# Production example: https://mahadev-chi.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (public project settings — never put write tokens here)
NEXT_PUBLIC_SANITY_PROJECT_ID=sacle4cb
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional aliases used by Sanity tooling
SANITY_STUDIO_PROJECT_ID=sacle4cb
SANITY_STUDIO_DATASET=production

# Optional: Viewer token for Live Content / draft previews
# SANITY_API_READ_TOKEN=

# Shared secret for Sanity → /api/revalidate webhook (and manual GET bust).
# Generate with: openssl rand -base64 32
# Must match the webhook secret in Sanity project settings.
SANITY_REVALIDATE_SECRET=
